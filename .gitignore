.sdd/

# qmd's local hybrid-search index (ADR-0024 makes qmd a hard dependency).
# A machine-local sqlite database plus embeddings, rebuilt by /sdd:index —
# committed, it is megabytes of binary that is stale the next commit.
.qmd/

# Local Claude Code settings — machine-specific, not shared.
.claude/settings.local.json

# Design handoff deliverables — contents are extracted into docs/design/.
nms-design*.zip
nmsbaseplannermocks.zip

# No Man's Sky save files — personal game state, never commit (ADR-0002).
# Includes decoded/decompressed dumps produced while working on the save parser.
*.hg
save*.hg
mf_save*.hg
**/HelloGames/**
*.save.json
*-decoded.json
testdata/saves/

# Agent worktrees created by /sdd:work — local scratch, never committed.
.claude/worktrees/

# Frontend build artifacts and dependencies (web/).
web/node_modules/
web/dist/
web/node_modules/.tmp/
# Built by web/scripts/build-wasm.sh from cmd/planner, the Go toolchain and
# data/tier1.json. wasm_exec.js in particular belongs to whichever toolchain
# compiled the module — a committed copy drifts and fails at instantiation.
web/public/planner.wasm
web/public/wasm_exec.js
web/public/tier1.json

web/playwright-report/
web/test-results/
